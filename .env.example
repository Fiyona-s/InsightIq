DATA_DIR=./data
# Optional SQLAlchemy catalog URL; defaults to SQLite inside DATA_DIR.
# DATABASE_URL=sqlite:///./data/catalog.sqlite

# scripts/demo.sh reads ONLY the LLM_* lines of your local .env (never printed, never committed) and starts on a fresh data folder.
# Provider must support OpenAI-compatible POST /chat/completions and strict JSON Schema.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Choose a model available to your account that supports structured outputs.
# Use your provider API base URL, not its account or API-key management web page.
# Set the matching provider base URL; this template never contains a key.
LLM_MODEL=
# Optional current rates for the configured model, USD per million tokens.
# Leave blank for unknown cost. Estimates do not include caching/discounts/taxes.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Upload limits (P4). Defaults were measured for a 2 GB container; raise them only with more memory.
# MAX_UPLOAD_MB=60
# MAX_UPLOAD_ROWS=1000000

# Local sentence-transformers assets. Provision explicitly before enabling RAG.
# Default: DATA_DIR/models/all-MiniLM-L6-v2 (Compose: /data/models/all-MiniLM-L6-v2).
# EMBEDDING_MODEL_PATH=./data/models/all-MiniLM-L6-v2

# Optional daily-reference currency conversion. Blank disables remote FX calls.
# Fixed approved HTTPS endpoint; no private API key is required.
FX_PROVIDER=

# Accounts (stage A1, in progress: there is no login screen yet).
# AUTH_MODE=off is today's local mode: no login. The app refuses to start with AUTH_MODE=off when APP_ENV=production
# or when INSIGHTIQ_BIND_HOST (set by `python -m app.serve`) is not a loopback address.
# AUTH_MODE=on requires a valid session for every route except health, auth status and login.
AUTH_MODE=off
# APP_ENV=production
# AUTH_COOKIE_SECURE=true
# AUTH_IDLE_SECONDS=43200
# AUTH_ABSOLUTE_SECONDS=604800
# AUTH_ALLOWED_ORIGINS=
# Owner two-step sign-in (stage A4). With AUTH_MODE=on (default AUTH_OWNER_TOTP=true) an owner must set up an authenticator app.
# AUTH_TOTP_KEY is a Fernet key kept per company, outside the database and its backups. If it is lost, owners must be
# re-enrolled with the operator command `accounts_cli.py reset-2fa`. Create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AUTH_OWNER_TOTP=true
# AUTH_TOTP_KEY=
